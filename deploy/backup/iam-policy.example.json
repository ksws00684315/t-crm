{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyBackupPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::EXAMPLE-TCRM-BACKUP-BUCKET",
      "Condition": {
        "StringLikeIfExists": {
          "s3:prefix": ["pgbackrest", "pgbackrest/*", "logical", "logical/*"]
        }
      }
    },
    {
      "Sid": "PgBackRestRepository",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::EXAMPLE-TCRM-BACKUP-BUCKET/pgbackrest/*"
    },
    {
      "Sid": "LogicalDumpsWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::EXAMPLE-TCRM-BACKUP-BUCKET/logical/*"
    },
    {
      "Sid": "NeverChangeProtectionOrDeleteVersions",
      "Effect": "Deny",
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention",
        "s3:PutReplicationConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucket",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::EXAMPLE-TCRM-BACKUP-BUCKET",
        "arn:aws:s3:::EXAMPLE-TCRM-BACKUP-BUCKET/*"
      ]
    }
  ]
}
