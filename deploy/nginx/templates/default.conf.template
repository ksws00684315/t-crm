# Rendered by the nginx image: ${TCRM_DOMAIN} is substituted at container start (NGINX_ENVSUBST_FILTER=^TCRM_).
# Sites:  t.<domain> redirect service | kol.<domain> creator portal | admin.<domain> admin console

server_tokens off;

# Login endpoint rate limit (Cloudflare rules are the first line; this protects the origin).
limit_req_zone $binary_remote_addr zone=tcrm_login:10m rate=10r/m;
# Login captcha issuing (ADR-017); the backend also limits 120 per IP per minute.
limit_req_zone $binary_remote_addr zone=tcrm_captcha:10m rate=120r/m;
# Redirect rate limit. Loose on purpose so shared mobile egress (CGNAT) is not blocked.
# Cloudflare rate limiting is the primary defense; this zone is the origin fallback.
limit_req_zone $binary_remote_addr zone=tcrm_redirect:10m rate=30r/s;

include /etc/nginx/snippets/cloudflare-real-ip.conf;

# Plain HTTP only redirects.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Unknown host names get no certificate and no content.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# ---- t.<domain>: redirect service (only /t/..., /i/... and /healthz are exposed) ----
server {
    listen 443 ssl;
    http2 on;
    server_name t.${TCRM_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    location /t/ {
        limit_req zone=tcrm_redirect burst=60 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-redirect:8081;
    }

    # Links written by the customer's sheet script: /i/{copied Weidian item ID} (ADR-019).
    location /i/ {
        limit_req zone=tcrm_redirect burst=60 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-redirect:8081;
    }

    location = /healthz {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-redirect:8081;
        access_log off;
    }

    location / {
        return 404;
    }
}

# ---- kol.<domain>: creator portal ----
server {
    listen 443 ssl;
    http2 on;
    server_name kol.${TCRM_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers-web.conf;

    root /usr/share/nginx/sites/kol;
    client_max_body_size 20m;

    location /kol-api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-admin:8080;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers-web.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---- admin.<domain>: admin console ----
server {
    listen 443 ssl;
    http2 on;
    server_name admin.${TCRM_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers-web.conf;

    root /usr/share/nginx/sites/admin;
    # Imports accept files up to 20MB (spec 06); the extra 1MB covers multipart overhead. The
    # 300MB promo-sheet upload does NOT go through this site: it has its own upload.<domain>
    # server below, because the Cloudflare proxy in front of this domain rejects bodies above
    # roughly 100MB on the free plan.
    client_max_body_size 21m;

    location = /admin-api/auth/login {
        limit_req zone=tcrm_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-admin:8080;
    }

    location = /admin-api/auth/captchas {
        limit_req zone=tcrm_captcha burst=30 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-admin:8080;
    }

    location /admin-api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://crm-admin:8080;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers-web.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---- upload.<domain>: promo-sheet upload only (task 26 review, 2026-10-18) ----
# The admin console's main domain sits behind the Cloudflare proxy, whose free plan rejects
# request bodies above roughly 100MB. The 300MB promo-sheet workbook therefore goes to this
# dedicated sub-domain, which the owner adds in Cloudflare as "DNS only" (grey cloud, not
# proxied). Same certificate and upstream as the other sites; nothing but the upload endpoint
# (and the CORS preflight the browser sends before it) is served here.
server {
    listen 443 ssl;
    http2 on;
    server_name upload.${TCRM_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    location ~ ^/admin-api/kol/kols/[0-9]+/promo-sheet-uploads$ {
        # The workbook upload is POST; OPTIONS must pass too — it is the CORS preflight the
        # browser sends first, and the backend answers it with the allow headers.
        limit_except POST OPTIONS {
            deny all;
        }
        client_max_body_size 300m;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_pass http://crm-admin:8080;
    }

    location / {
        return 404;
    }
}
