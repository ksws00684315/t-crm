# SparkTrack environment variables. Copy to deploy/.env and fill in real values; never commit .env.
# Spring Boot does not read this file by itself: docker compose injects it (--env-file) and local runs
# export the values from the shell/IDE. Variables not marked "optional" must be set.

# ---- Ports ----
# Backend (crm-admin) and redirect service (crm-redirect) listen ports.
TCRM_ADMIN_PORT=8080
TCRM_REDIRECT_PORT=8081
# Host ports of the DEV compose file (docker-compose.dev.yml). Change them when 5432 / 6379 are already
# taken on your machine; a locally started backend/redirect reads the same variables to connect.
TCRM_DB_PORT=5432
TCRM_REDIS_PORT=6379

# ---- PostgreSQL ----
# Dev: TCRM_DB_HOST=localhost. Prod compose overrides host/port with the internal service name.
TCRM_DB_HOST=localhost
TCRM_DB_NAME=tcrm
# Application account used by crm-admin (and Flyway). Dev compose: created by the PostgreSQL image as
# a superuser. Prod compose: created by deploy/postgres/initdb/01-app-role.sh as a NON-superuser that
# owns the database; it must differ from TCRM_DB_SUPERUSER_USERNAME. Only applied the first time the
# data volume is initialised (an existing volume keeps its accounts).
TCRM_DB_USERNAME=
TCRM_DB_PASSWORD=
# Production only (docker-compose.prod.yml): administration superuser (POSTGRES_USER), used by the
# initdb script and the pg_dump backup. Never given to crm-admin; use a different password from the above.
TCRM_DB_SUPERUSER_USERNAME=
TCRM_DB_SUPERUSER_PASSWORD=

# ---- Redis ----
TCRM_REDIS_HOST=localhost
# Optional in dev; REQUIRED in prod (the prod compose file refuses to start Redis without it).
TCRM_REDIS_PASSWORD=

# ---- Backend ----
# Required when no enabled, non-deleted platform administrator exists; missing values abort
# startup. The username must not already belong to any user. After the first start, sign in
# as this platform administrator and create a super administrator for the default company.
TCRM_BOOTSTRAP_ADMIN_USERNAME=
TCRM_BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated front-end origins allowed by CORS. Leave empty behind Nginx (same origin).
# The promo-sheet upload (task 26) is served on its own upload.<domain> (Cloudflare "DNS only"),
# so the admin console origin must be listed here for the cross-origin upload to pass.
TCRM_CORS_ALLOWED_ORIGINS=
# Required: public base of the tracking links, https without a trailing slash; links are
# {TCRM_LINK_BASE_URL}/t/{kolCode}/{productCode}. Production: https://t.<TCRM_DOMAIN>.
# Missing or malformed values abort backend startup.
TCRM_LINK_BASE_URL=https://t.example.com
# Required: KOL portal base URL, https without a trailing slash; invitation and password-reset
# mails link to {TCRM_KOL_PORTAL_BASE_URL}/activate?token=... and /reset?token=...
# Production: https://kol.<TCRM_DOMAIN>. Missing or malformed values abort backend startup.
TCRM_KOL_PORTAL_BASE_URL=https://kol.example.com
# Required: Weidian OAuth callback base URL, https without a trailing slash; register this domain
# as the callback domain in the Weidian Open Platform. Example: https://admin.example.com
TCRM_ADMIN_BASE_URL=https://admin.example.com
# Required: 32 random bytes, Base64 encoded. Keep a protected backup; losing it requires every
# encrypted integration credential to be entered again. Generate with: openssl rand -base64 32
TCRM_SECRET_KEY=

# ---- Mail (Resend, KOL invitations and password resets) ----
# Resend API key (https://resend.com). Empty = logging fallback: mails are only logged, no link
# is sent — fine for local development, not for production.
TCRM_MAIL_API_KEY=
# Sender address, e.g. "SparkTrack <no-reply@example.com>". REQUIRED when TCRM_MAIL_API_KEY is set;
# the backend refuses to start with a key but no sender. The domain must be verified in Resend
# with SPF, DKIM and DMARC records (see deploy/README.md).
TCRM_MAIL_FROM=

# ---- Redirect service ----
TCRM_REDIRECT_FALLBACK_URL=
# Required; shared by redirect and backend（跳转服务与后端共用）.
# At least 32 characters, or the redirect service refuses to start.
# Generate with: openssl rand -hex 32
TCRM_IP_HASH_SALT=

# ---- Client IP / click stream (ADR-009, ADR-008) ----
# Comma-separated IPs/CIDRs of reverse proxies allowed to set forwarding headers.
# Empty = trust none (TCP peer address is used).
# For local / IDE runs only: production compose hard-codes TCRM_TRUSTED_PROXIES=172.30.0.0/24
# (the compose network subnet) and ignores this variable.
TCRM_TRUSTED_PROXIES=
# Optional override: headers carrying the client IP, in priority order.
# Default when unset or empty: CF-Connecting-IP,X-Forwarded-For (ClientIpResolver).
# Production compose passes this through; leave commented to use the default.
# TCRM_CLIENT_IP_HEADERS=CF-Connecting-IP,X-Forwarded-For
# Optional: approximate MAXLEN of the click stream in Redis (oldest clicks trimmed beyond it).
# The backend warns when the unconsumed backlog exceeds 50% of it and logs an error above 80%.
# Default when unset: 1000000. Production compose passes ${TCRM_CLICK_STREAM_MAXLEN:-1000000}
# to both crm-redirect and crm-admin.
# TCRM_CLICK_STREAM_MAXLEN=1000000

# Production compose only: leave unset or empty (strict) so crm-admin refuses to start when the database
# schema is newer than the image (rollback safety, #106). Set to '*:future' only for the emergency
# rollback in deploy/README.md ("Release and rollback"), then remove it again. The dev and preview
# compose files do not read this and keep the lenient default locally.
# TCRM_FLYWAY_IGNORE_MIGRATION_PATTERNS=

# ---- Production deployment only (docker-compose.prod.yml) ----
# Images are built and pushed by .github/workflows/release.yml and pulled by deploy/scripts/release.sh.
# Registry namespace WITHOUT a trailing slash (lower case): crm-admin, crm-redirect, crm-postgres and
# crm-static are pulled from <namespace>/<name>:<TCRM_VERSION>; crm-postgres uses
# TCRM_POSTGRES_VERSION (see below).
TCRM_IMAGE_REGISTRY=ghcr.io/ksws00684315
# Deployed version without the leading "v" (git tag v1.0.0 -> 1.0.0). release.sh writes it after a
# successful release; set it by hand only to bootstrap a host (see deploy/README.md).
TCRM_VERSION=1.0.0
# Database image tag (L-073). release.sh pins this on the first deploy to the then-current
# TCRM_VERSION and leaves it alone afterwards; pass `deploy --postgres <ver>` only when you
# intentionally upgrade postgres. Keep it empty here: empty / missing falls back to TCRM_VERSION
# in Compose, so a host copied verbatim does not pin the database image to an old release.
TCRM_POSTGRES_VERSION=
# Base domain; Nginx serves t.<domain> (redirect), kol.<domain> (creator portal), admin.<domain> (admin console).
TCRM_DOMAIN=example.com
# Certificate directory, mounted read-only into Nginx:
#   <dir>/origin.pem, <dir>/origin.key  Cloudflare origin certificate (t., kol.), copied by hand
#   <dir>/public.pem, <dir>/public.key  Let's Encrypt certificate (admin., upload.), written by
#                                       deploy/scripts/renew-public-cert.sh (mode 600)
TCRM_CERT_DIR=./certs
# renew-public-cert.sh only (host cron, not read by Compose): file holding the Cloudflare API token for
# the DNS-01 challenge ("dns_cloudflare_api_token = ..."). Keep it OUTSIDE this repository, mode 600;
# the token never goes into this .env file or into logs.
TCRM_CERTBOT_CLOUDFLARE_INI=
# renew-public-cert.sh only: contact e-mail for the Let's Encrypt account (expiry notices).
TCRM_CERTBOT_EMAIL=
# Directory with the front-end releases, mounted read-only into Nginx. release.sh keeps
# <dir>/releases/<version>/admin|kol (the last 5 versions) and the relative symlink <dir>/current ->
# releases/<version>. Relative paths are resolved against the deploy/ directory.
TCRM_STATIC_DIR=./www
# ---- Backup and restore (ADR-037 decision 5; deploy/README.md "Backup and restore") ----
# Host directory for the encrypted daily pg_dump files (deploy/backup/pg-backup.sh)
TCRM_BACKUP_DIR=./backups
# pg_dump upload target (S3). Leave TCRM_BACKUP_S3_BUCKET empty to keep the encrypted dumps local only.
# Credentials are NOT set here: the AWS CLI default chain finds them (instance role, or ~/.aws on the host).
TCRM_BACKUP_S3_BUCKET=
# Key prefix inside the bucket; dumps go to <prefix>/daily/ and <prefix>/weekly/.
TCRM_BACKUP_S3_PREFIX=logical
AWS_REGION=us-west-2
# File holding the pg_dump encryption passphrase (gpg symmetric AES256), mode 600, kept OUTSIDE this
# repository and stored separately from the backups and from TCRM_SECRET_KEY.
TCRM_BACKUP_PASSPHRASE_FILE=
# pgBackRest repository (continuous WAL archive plus full/differential backups, client-side encrypted).
# These are pgBackRest's native variables; PGBACKREST_REPO1_S3_BUCKET and PGBACKREST_REPO1_CIPHER_PASS
# are required. Optional lines must be commented out or deleted, never left
# empty: pgBackRest rejects an empty PGBACKREST_* variable.
PGBACKREST_REPO1_TYPE=s3
PGBACKREST_REPO1_PATH=/pgbackrest
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_REGION=us-west-2
# Defaults to s3.<region>.amazonaws.com when commented out.
# PGBACKREST_REPO1_S3_ENDPOINT=s3.us-west-2.amazonaws.com
# Repository encryption passphrase (aes-256-cbc). Generate with: openssl rand -base64 32
# Losing it makes every backup unreadable; store it separately from the backups and from TCRM_SECRET_KEY.
PGBACKREST_REPO1_CIPHER_PASS=
# Credentials come from the EC2 instance role only (ADR-037 decision 1) — there is no access key
# option. The container cannot read the instance metadata itself (IMDSv2, hop limit 1, L-107), so
# the HOST fetches temporary credentials every 15 minutes and writes them into this directory
# (deploy/backup/refresh-s3-credentials.sh, host cron). Order on first enablement: create the
# directory, run the refresh script once, then start postgres. The directory is mounted read-only
# into the postgres container and MUST stay OUTSIDE this repository. A posix repository
# (PGBACKREST_REPO1_TYPE=posix) needs no credentials and leaves the directory empty.
TCRM_PGBACKREST_CREDS_DIR=/var/lib/tcrm/pgbackrest-creds

# ---- Runtime system configuration defaults ----
# Optional promo-sheet upload sub-domain. Empty uses the admin console's same origin.
# The 300MB workbook upload must bypass the Cloudflare proxy (free plan rejects ~100MB bodies),
# so upload.<domain> should be added in Cloudflare as "DNS only".
TCRM_UPLOAD_BASE_URL=

# ---- Ops monitoring (host cron every 5 min, deploy/scripts/ops-check.sh; task 96) ----
# Feishu custom bot webhook that receives the alerts; empty = alerts are only printed to stdout.
TCRM_ALERT_WEBHOOK_URL=
# Pinged once per run (Healthchecks.io style); empty = skip. The external service alerts when
# the pings stop, which covers the script or the whole host dying.
TCRM_HEARTBEAT_URL=
# Directory holding the alert state (dedup: one repeat per hour; recovery notices).
TCRM_OPS_STATE_DIR=
# Threshold overrides for testing — the defaults are the production values: disk 70 (warn) /
# 85 (critical) percent used; minimum available memory 10 percent; public certificate 20 days;
# backups (pgBackRest and logical) 26 hours; WAL archive 15 minutes; backup credentials refresh
# (file age) 60 minutes; container restart window 5 minutes; alert repeat 1 hour.
# TCRM_OPS_DISK_WARN_PERCENT=70
# TCRM_OPS_DISK_CRIT_PERCENT=85
# TCRM_OPS_MEM_MIN_AVAIL_PERCENT=10
# TCRM_OPS_CERT_MIN_DAYS=20
# TCRM_OPS_BACKUP_MAX_AGE_HOURS=26
# TCRM_OPS_WAL_MAX_AGE_MINUTES=15
# TCRM_OPS_CREDS_MAX_AGE_MINUTES=60
# TCRM_OPS_RESTART_WINDOW_MINUTES=5
# TCRM_OPS_ALERT_REPEAT_HOURS=1
