{
  "name": "tcrm-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T-CRM admin console (Vue 3 + Element Plus), derived from pure-admin-thin v6.2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "notices": "generate-license-file --input package.json --output THIRD-PARTY-NOTICES --overwrite --ci --no-spinner --eol lf",
    "notices:check": "mkdir -p node_modules/.cache && generate-license-file --input package.json --output node_modules/.cache/THIRD-PARTY-NOTICES.check --overwrite --ci --no-spinner --eol lf && diff -u THIRD-PARTY-NOTICES node_modules/.cache/THIRD-PARTY-NOTICES.check"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.20.0",
    "element-plus": "2.14.7",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.11.1",
    "generate-license-file": "4.2.5",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
