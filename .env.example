# Local settings only. Supply values through your shell/IDE; Spring does not load this file.
TCRM_ADMIN_PORT=8080
TCRM_REDIRECT_PORT=8081
TCRM_DB_HOST=localhost
TCRM_DB_PORT=5432
TCRM_DB_NAME=tcrm
TCRM_DB_USERNAME=
TCRM_DB_PASSWORD=
TCRM_REDIS_HOST=localhost
TCRM_REDIS_PORT=6379
TCRM_REDIS_PASSWORD=
# Required when no enabled, non-deleted super administrator exists; missing values abort startup.
TCRM_BOOTSTRAP_ADMIN_USERNAME=
TCRM_BOOTSTRAP_ADMIN_PASSWORD=
TCRM_CORS_ALLOWED_ORIGINS=
TCRM_REDIRECT_FALLBACK_URL=
TCRM_IP_HASH_SALT=
# Comma-separated IPs/CIDRs of reverse proxies (Nginx, Cloudflare edge) allowed to set forwarding headers. Empty = trust none.
TCRM_TRUSTED_PROXIES=
# Optional override: headers carrying the client IP, in priority order (the value below is the default).
# TCRM_CLIENT_IP_HEADERS=CF-Connecting-IP,X-Forwarded-For
# Optional: approximate MAXLEN of the click stream in Redis (default 1000000; oldest clicks are trimmed beyond it).
# TCRM_CLICK_STREAM_MAXLEN=1000000
